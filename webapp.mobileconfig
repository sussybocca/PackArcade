<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.arcade.webapp.webclip</string>
            <key>PayloadUUID</key>
            <string>WEB-CLIP-UNIQUE-ID-12345</string>
            <key>PayloadDisplayName</key>
            <string>Arcade Web App</string>
            <key>URL</key>
            <string>https://your-domain.com</string>
            <key>Icon</key>
            <data>
            <!-- Base64 encoded 512x512 PNG icon would go here -->
            </data>
            <key>Label</key>
            <string>Arcade Web App</string>
            <key>IsRemovable</key>
            <true/>
            <key>Precomposed</key>
            <true/>
            <key>FullScreen</key>
            <true/>
            <key>IgnoreManifestScope</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>Arcade Web App Installer</string>
    <key>PayloadDescription</key>
    <string>Installs Arcade Web App to your home screen with full-screen capabilities</string>
    <key>PayloadIdentifier</key>
    <string>com.arcade.webapp.installer</string>
    <key>PayloadOrganization</key>
    <string>Arcade</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>ROOT-UUID-12345-67890</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
